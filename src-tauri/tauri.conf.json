{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nabbit",
  "version": "0.1.0",
  "identifier": "com.nabbit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nabbit",
        "width": 460,
        "height": 680,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/deno"],
    "resources": [
      "../PRIVACY.md",
      "../src/assets/fonts/OFL.txt",
      "../third-party/ffmpeg/",
      "../third-party/notices.json"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": { "installerHooks": "./windows/hooks.nsh" },
      "wix": {
        "fragmentPaths": ["./windows/context-cleanup.wxs"],
        "componentRefs": ["NabbitContextCleanup"]
      }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["nabbit"] } },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
