<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Component Id="NabbitContextCleanup" Directory="TARGETDIR" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Nabbit\Installer" Name="ContextCleanup" Value="1" Type="integer" KeyPath="yes" />
    </Component>
    <CustomAction Id="NabbitRemoveUserContext" FileKey="Path" ExeCommand="--unregister-context" Execute="immediate" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="NabbitRemoveUserContext" Before="RemoveFiles">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
